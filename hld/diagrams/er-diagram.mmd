erDiagram
    AIRPORT ||--o{ FLIGHT_SCHEDULE : "source"
    AIRPORT ||--o{ FLIGHT_SCHEDULE : "destination"
    AIRCRAFT ||--o{ FLIGHT_SCHEDULE : "operates"
    FLIGHT_SCHEDULE ||--|{ FLIGHT_SCHEDULE_DAY : "runs on"
    FLIGHT_SCHEDULE ||--o{ FLIGHT_INSTANCE : "generates"
    FLIGHT_INSTANCE ||--o{ BOOKING : "has"
    BOOKING ||--|{ BOOKING_SEAT : "holds"
    FLIGHT_INSTANCE ||--o{ BOOKING_SEAT : "seat inventory"

    AIRPORT {
        varchar code PK
        varchar name
        varchar city
        varchar country
    }
    AIRCRAFT {
        bigint id PK
        varchar aircraft_type
        int seat_rows
        varchar seat_letters
    }
    FLIGHT_SCHEDULE {
        bigint id PK
        varchar flight_number UK
        varchar source_airport FK
        varchar destination_airport FK
        time departure_time
        time arrival_time
        bigint aircraft_id FK
    }
    FLIGHT_SCHEDULE_DAY {
        bigint schedule_id PK, FK
        varchar day_of_week PK
    }
    FLIGHT_INSTANCE {
        bigint id PK
        bigint schedule_id FK
        date flight_date
        timestamptz departure_at
        timestamptz arrival_at
    }
    BOOKING {
        uuid id PK
        bigint flight_instance_id FK
        varchar status
        int passenger_count
        timestamptz cancelled_at
        bigint version
    }
    BOOKING_SEAT {
        bigint id PK
        uuid booking_id FK
        bigint flight_instance_id FK
        varchar seat_label
        varchar passenger_name
        boolean active
    }
